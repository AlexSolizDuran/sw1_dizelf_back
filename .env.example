# Entorno y Servidor
PORT=3001
NODE_ENV=development

# Base de Datos (Neon Cloud PostgreSQL compartida)
NEON_DB_URL="postgresql://usuario:password@host.neon.tech/neondb?sslmode=require&connect_timeout=30"

# Seguridad y Autenticación (JWT)
