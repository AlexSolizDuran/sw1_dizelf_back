# Entorno y Servidor
PORT=3001
NODE_ENV=development

# Base de Datos (Neon Cloud PostgreSQL)
# url: conexión agrupada (pooler) para el runtime de la app
NEON_DB_URL="postgresql://neondb_owner:password@ep-ejemplo-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"
# directUrl: host directo (sin -pooler) requerido por prisma migrate
NEON_DIRECT_URL="postgresql://neondb_owner:password@ep-ejemplo.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

# Seguridad y Autenticación (JWT)
JWT_SECRET=tu_secreto_super_seguro_cambiar_en_produccion_minimo_32_caracteres
JWT_EXPIRACION=1d

# Integración Frontend / CORS
# Debe ser el origen EXACTO del front (sin '/' final). Acepta lista con comas.
FRONTEND_URL=http://localhost:5173
# true solo en producción https con dominios distintos (SameSite=None; Secure).
# En localhost http debe ser false (SameSite=Lax sin Secure) o la cookie se pierde al F5.
COOKIE_SECURE=false
