model Usuario {
    id            Int    @id @default(autoincrement()) @map("usuario_id")
    username      String @unique @db.VarChar(100)
    hashContrasena String @map("hash_contrasena") @db.VarChar(100)

    // Relación 1:1 con Persona. La FK vive aquí, por eso @unique.
    personaId Int     @unique @map("persona_id")
    persona   Persona @relation(fields: [personaId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    // Campos virtuales inversos: no generan columna.
    proyectosCreados Proyecto[]
    colaboraciones   Colaborador[]

    @@map("usuario")
}
