model Version {
  id          Int      @id @default(autoincrement()) @map("version_id")
  esquemaJson Json     @map("esquema_json_version") @db.JsonB
  fecha       DateTime @default(now()) @map("fecha_version") @db.Timestamp(3)

  // Relación 1:N: un proyecto tiene muchas versiones.
  proyectoId String   @map("proyecto_id") @db.Uuid
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@index([fecha])
  @@map("version")
}
