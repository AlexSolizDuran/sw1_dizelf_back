model Proyecto {
  id          String @id @default(uuid()) @map("proyecto_id") @db.Uuid
  nombre      String @map("nombre_proyecto") @db.VarChar(100)
  esquemaJson Json   @map("esquema_json") @db.JsonB

  // Relación 1:N: un usuario crea muchos proyectos.
  creadorId Int     @map("usuario_id")
  creador   Usuario @relation(fields: [creadorId], references: [id], onDelete: Cascade)

  // Campos virtuales inversos: no generan columna.
  versiones     Version[]
  colaboradores Colaborador[]
  documentos    DocumentoColaborativo[]

  @@index([nombre])
  @@map("proyecto")
}
