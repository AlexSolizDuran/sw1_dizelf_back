model Persona {
  id       Int    @id @default(autoincrement()) @map("persona_id")
  nombre   String @map("nombre_persona") @db.VarChar(80)
  apellido String @map("apellido_persona") @db.VarChar(80)
  gmail    String @unique @db.VarChar(80)

  // Relación 1:1 inversa. Campo virtual: no genera columna.
  usuario Usuario?

  @@map("persona")
}
